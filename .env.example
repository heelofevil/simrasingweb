FLASK_ENV=production
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg2://pitline:pitline@db:5432/pitline
POSTGRES_USER=pitline
POSTGRES_PASSWORD=pitline
POSTGRES_DB=pitline

# Admin (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# Bitrix24 incoming webhook (Applications → Webhooks → Inbound)
# Example: https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
BITRIX24_WEBHOOK_URL=
BITRIX24_SOURCE_ID=WEB
BITRIX24_ASSIGNED_BY_ID=
BITRIX24_TIMEOUT=8

# Lead anti-abuse
LEAD_RATE_IP_LIMIT=8
LEAD_RATE_IP_WINDOW=600
LEAD_RATE_CONTACT_LIMIT=4
LEAD_RATE_CONTACT_WINDOW=600
LEAD_RATE_BURST_LIMIT=2
LEAD_RATE_BURST_WINDOW=20
